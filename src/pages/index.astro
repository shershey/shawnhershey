---
import Layout from '../layouts/Layout.astro';
import { Content } from '../content/home.md';

// Featured video shown on the landing page.
// To feature a different clip, change the YouTube id and caption below
// (the id is the v=... part of a youtube.com/watch URL).
const featured = {
  youtubeId: 'ouRiBgvzBeI',
  caption: '1st place — Open Mix & Match, Cal Bal 2026',
};
---
<Layout>
  <Content />

  <section class="featured">
    <h2>Watch</h2>
    <div class="frame">
      <iframe
        src={`https://www.youtube.com/embed/${featured.youtubeId}?rel=0`}
        title={featured.caption}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
    <p class="caption">{featured.caption}</p>
    <p class="more"><a href="/videos">See more videos &rarr;</a></p>
  </section>

  <style>
    .featured {
      margin-top: 2.5rem;
    }
    .frame {
      position: relative;
      aspect-ratio: 16 / 9;
      border-radius: 6px;
      overflow: hidden;
      box-shadow: 0 3px 14px rgba(30, 26, 22, 0.25);
    }
    .frame iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .caption {
      margin-top: 0.85rem;
      font-style: italic;
      color: #5a4a36;
    }
    .more {
      margin-top: 0.35rem;
    }
  </style>
</Layout>
