---
import Layout from '../layouts/Layout.astro';
import { Content } from '../content/home.md';

// Featured video shown on the landing page.
// To feature a different clip, change the YouTube id and caption below
// (the id is the v=... part of a youtube.com/watch URL).
const featured = {
  youtubeId: 'K1UwFi6Lnq4',
  caption: 'Teacher Demo at Policoro in Swing 2026',
};

// The Fried Bananas albums (Bandcamp). Player colors are tuned to this
// site's cream/brown palette. Full tracklists + downloads live on the
// band's own site, thefriedbananas.com.
const albums = [
  {
    id: '3311730543',
    title: 'Live at Montreal Dance Fest & Sweet Molasses Blues',
    year: '2014',
    url: 'https://shawnhershey.bandcamp.com/album/the-fried-bananas-live-at-montreal-dance-fest-sweet-molasses-blues',
  },
  {
    id: '234184643',
    title: 'Live at the 2014 Albany Lindy and Blues Exchange',
    year: '2015',
    url: 'https://shawnhershey.bandcamp.com/album/the-fried-bananas',
  },
];
const bcParams = 'size=large/bgcol=f7f2ea/linkcol=7a4f1e/tracklist=false/transparent=true';
---
<Layout>
  <section class="hero">
    <span class="hero-bar" aria-hidden="true"></span>
    <div class="hero-body">
      <p class="kicker">Swing &middot; Blues &middot; Balboa &middot; Lindy Hop</p>
      <h1>Shawn Hershey</h1>
      <!-- Editable tagline lives in src/content/home.md -->
      <div class="intro"><Content /></div>
    </div>
  </section>

  <section class="featured">
    <h2>Watch</h2>
    <div class="frame">
      <iframe
        src={`https://www.youtube.com/embed/${featured.youtubeId}?rel=0`}
        title={featured.caption}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
    <p class="caption">{featured.caption}</p>
    <p class="more"><a href="/videos">See more videos &rarr;</a></p>
  </section>

  <section class="listen">
    <h2>Listen</h2>
    <p class="lead">With <strong>The Fried Bananas</strong>, my blues &amp; swing band &mdash; live off the bandstand.</p>
    <div class="albums">
      {albums.map((a) => (
        <div class="album">
          <iframe
            src={`https://bandcamp.com/EmbeddedPlayer/album=${a.id}/${bcParams}/`}
            title={a.title}
            loading="lazy"
            seamless
          ><a href={a.url}>{a.title}</a></iframe>
          <p class="album-title">{a.title}<span class="yr"> &middot; {a.year}</span></p>
        </div>
      ))}
    </div>
    <p class="more"><a href="https://thefriedbananas.com" target="_blank" rel="noopener">Hear the full band at thefriedbananas.com &rarr;</a></p>
  </section>

  <style>
    /* Hero — gold accent bar, small-caps kicker, name, tagline */
    .hero {
      display: flex;
      gap: 1.4rem;
      margin-top: 0.25rem;
    }
    .hero-bar {
      flex: 0 0 4px;
      align-self: stretch;
      background: var(--gold);
      border-radius: 2px;
    }
    .hero-body {
      min-width: 0;
    }
    .kicker {
      margin: 0 0 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.3em;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--gold-ink);
    }
    /* Hero name is the exception to the global h1: bigger, and it carries
       the vertical gold bar instead of the underline accent. */
    .hero h1 {
      margin: 0;
      padding: 0;
      font-size: 3.1rem;
      line-height: 1.05;
    }
    .hero h1::after {
      content: none;
    }
    /* Tagline rendered from home.md */
    .intro :global(p) {
      margin-top: 1.1rem;
      max-width: 34rem;
      font-size: 1.3rem;
      line-height: 1.55;
      color: var(--brown-soft);
    }
    .intro :global(p a) {
      color: var(--brown);
    }

    /* Sections use the global h2 treatment; just add breathing room above. */
    .featured,
    .listen {
      margin-top: 2.75rem;
    }
    .featured h2,
    .listen h2 {
      margin-top: 0;
    }

    /* Watch */
    .frame {
      position: relative;
      aspect-ratio: 16 / 9;
      border-radius: 6px;
      overflow: hidden;
      box-shadow: 0 3px 14px rgba(30, 26, 22, 0.25);
    }
    .frame iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .caption {
      margin-top: 0.85rem;
      font-style: italic;
      color: var(--brown-soft);
    }
    .more {
      margin-top: 0.35rem;
    }

    /* Listen */
    .listen .lead {
      margin-top: 0;
      color: var(--brown-soft);
    }
    .albums {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
      margin-top: 1.25rem;
    }
    .album iframe {
      width: 100%;
      height: 340px;
      border: 0;
      border-radius: 6px;
      box-shadow: 0 3px 14px rgba(30, 26, 22, 0.2);
    }
    .album-title {
      margin-top: 0.6rem;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--brown-dark);
    }
    .album-title .yr {
      font-weight: 400;
      color: var(--muted);
    }

    @media (max-width: 480px) {
      .hero h1 {
        font-size: 2.5rem;
      }
      .intro :global(p) {
        font-size: 1.2rem;
      }
    }
  </style>
</Layout>
